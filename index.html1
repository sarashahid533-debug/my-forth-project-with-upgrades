<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Dr. A.P.J. Abdul Kalam | Official Memorial Website</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: #f5f7fb;
      color: #222;
      line-height: 1.8;
    }

    /* NAVBAR */
    nav {
      position: fixed;
      width: 100%;
      top: 0;
      z-index: 1000;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(8px);
      padding: 20px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      color: white;
      font-size: 28px;
      font-weight: 700;
    }

    .logo span {
      color: #ffd60a;
    }

    nav ul {
      display: flex;
      list-style: none;
      gap: 30px;
    }

    nav ul li a {
      color: white;
      text-decoration: none;
      transition: 0.3s;
      font-size: 15px;
    }

    nav ul li a:hover {
      color: #ffd60a;
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      background:
        linear-gradient(rgba(0, 0, 0, 0.7),
          rgba(0, 0, 0, 0.7)),
        url("https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1600&auto=format&fit=crop");

      background-size: cover;
      background-position: center;

      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;

      color: white;
      padding: 120px 20px;
    }

    .hero-content {
      max-width: 950px;
    }

    .hero img {
      width: 240px;
      height: 240px;
      object-fit: cover;
      border-radius: 50%;
      border: 6px solid white;
      margin-bottom: 30px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .hero h1 {
      font-size: 70px;
      margin-bottom: 10px;
    }

    .hero h3 {
      color: #ffd60a;
      font-size: 28px;
      margin-bottom: 25px;
    }

    .hero p {
      max-width: 750px;
      margin: auto;
      font-size: 18px;
      color: #eee;
    }

    .hero-btns {
      margin-top: 40px;
    }

    .btn {
      display: inline-block;
      padding: 14px 35px;
      margin: 10px;
      border-radius: 50px;
      transition: 0.3s;
      font-weight: 600;
    }

    .btn-primary {
      background: #ffd60a;
      color: black;
    }

    .btn-primary:hover {
      transform: translateY(-5px);
    }

    .btn-outline {
      border: 2px solid white;
      color: white;
    }

    .btn-outline:hover {
      background: white;
      color: black;
    }

    /* SECTION */
    section {
      padding: 100px 8%;
    }

    .section-title {
      text-align: center;
      margin-bottom: 60px;
    }

    .section-title h2 {
      font-size: 45px;
      color: #0d1b2a;
    }

    .section-title p {
      color: #666;
      margin-top: 10px;
    }

    /* ABOUT */
    .about-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 50px;
      align-items: center;
    }

    .about-grid img {
      width: 100%;
      border-radius: 20px;
    }

    .about-text h3 {
      font-size: 35px;
      margin-bottom: 20px;
      color: #0d1b2a;
    }

    /* CARDS */
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 30px;
    }

    .card {
      background: white;
      padding: 35px;
      border-radius: 18px;
      transition: 0.4s;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .card:hover {
      transform: translateY(-10px);
    }

    .card i {
      font-size: 45px;
      color: #0d6efd;
      margin-bottom: 20px;
    }

    /* TIMELINE */
    .timeline {
      border-left: 4px solid #0d6efd;
      padding-left: 40px;
    }

    .timeline-item {
      margin-bottom: 50px;
      position: relative;
    }

    .timeline-item::before {
      content: "";
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #0d6efd;
      position: absolute;
      left: -50px;
      top: 5px;
    }

    /* QUOTE */
    .quote {
      background: linear-gradient(to right,#0d1b2a,#1b263b);
      color: white;
      border-radius: 20px;
      padding: 80px;
      text-align: center;
    }

    .quote i {
      color: #ffd60a;
      font-size: 50px;
      margin-bottom: 20px;
    }

    .quote h2 {
      font-size: 38px;
      font-weight: 500;
    }

    /* BOOKS */
    .book-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px,1fr));
      gap: 30px;
    }

    .book {
      background: white;
      border-radius: 15px;
      overflow: hidden;
      box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    .book img {
      width: 100%;
      height: 320px;
      object-fit: cover;
    }

    .book-content {
      padding: 25px;
    }

    /* STATS */
    .stats {
      background: #08111f;
      color: white;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px,1fr));
      gap: 30px;
      text-align: center;
    }

    .stat h1 {
      font-size: 55px;
      color: #ffd60a;
    }

    /* FOOTER */
    footer {
      background: black;
      color: #bbb;
      text-align: center;
      padding: 40px;
    }

    @media(max-width:768px) {

      .hero h1 {
        font-size: 42px;
      }

      nav {
        flex-direction: column;
      }

      nav ul {
        flex-wrap: wrap;
        justify-content: center;
      }

      .quote h2 {
        font-size: 28px;
      }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <nav>

    <div class="logo">
      Abdul<span>Kalam</span>
    </div>

    <ul>
      <li><a href="#about">About</a></li>
      <li><a href="#timeline">Timeline</a></li>
      <li><a href="#books">Books</a></li>
      <li><a href="#vision">Vision</a></li>
      <li><a href="#gallery">Gallery</a></li>
      <li><a href="#legacy">Legacy</a></li>
    </ul>

  </nav>

  <!-- HERO -->
  <section class="hero">

    <div class="hero-content">

      <img
        src="https://upload.wikimedia.org/wikipedia/commons/b/b0/A_P_J_Abdul_Kalam.jpg"
        alt="">

      <h1>Dr. A.P.J. Abdul Kalam</h1>

      <h3>Missile Man of India • People's President</h3>

      <p>
        “Dream transforms into thoughts and thoughts result in action.”
      </p>

      <div class="hero-btns">

        <a href="#about" class="btn btn-primary">
          Explore Life
        </a>

        <a href="#timeline" class="btn btn-outline">
          View Journey
        </a>

      </div>

    </div>

  </section>

  <!-- ABOUT -->
  <section id="about">

    <div class="section-title">
      <h2>About</h2>

      <p>
        The inspiring story of a scientist who became a national icon.
      </p>
    </div>

    <div class="about-grid">

      <img
        src="https://images.unsplash.com/photo-1497633762265-9d179a990aa6?q=80&w=1200&auto=format&fit=crop">

      <div class="about-text">

        <h3>The Journey of Excellence</h3>

        <p>
          Dr. A.P.J. Abdul Kalam was born on 15 October 1931 in
          Rameswaram, Tamil Nadu. He became one of India’s most respected
          scientists and leaders. :contentReference[oaicite:0]{index=0}
        </p>

        <p>
          Known as the “Missile Man of India,” he contributed significantly
          to India’s missile and space programs through DRDO and ISRO. :contentReference[oaicite:1]{index=1}
        </p>

        <p>
          In 2002, he became the 11th President of India and inspired
          millions through education and innovation. :contentReference[oaicite:2]{index=2}
        </p>

      </div>

    </div>

  </section>

  <!-- VISION -->
  <section id="vision">

    <div class="section-title">
      <h2>Core Vision</h2>
    </div>

    <div class="cards">

      <div class="card">
        <i class="fa-solid fa-book"></i>
        <h3>Education</h3>

        <p>
          He believed education can transform society.
        </p>
      </div>

      <div class="card">
        <i class="fa-solid fa-rocket"></i>
        <h3>Innovation</h3>

        <p>
          Encouraged youth to explore science and technology.
        </p>
      </div>

      <div class="card">
        <i class="fa-solid fa-lightbulb"></i>
        <h3>Dream Big</h3>

        <p>
          Inspired generations to think beyond limitations.
        </p>
      </div>

    </div>

  </section>

  <!-- TIMELINE -->
  <section id="timeline">

    <div class="section-title">
      <h2>Life Timeline</h2>
    </div>

    <div class="timeline">

      <div class="timeline-item">
        <h3>1931 — Birth</h3>

        <p>
          Born in Rameswaram, Tamil Nadu. :contentReference[oaicite:3]{index=3}
        </p>
      </div>

      <div class="timeline-item">
        <h3>1980 — Satellite Launch</h3>

        <p>
          Led India's first satellite launch vehicle mission. :contentReference[oaicite:4]{index=4}
        </p>
      </div>

      <div class="timeline-item">
        <h3>1998 — Pokhran-II</h3>

        <p>
          Played a major role in nuclear tests. :contentReference[oaicite:5]{index=5}
        </p>
      </div>

      <div class="timeline-item">
        <h3>2002 — President of India</h3>

        <p>
          Became India’s 11th President. :contentReference[oaicite:6]{index=6}
        </p>
      </div>

    </div>

  </section>

  <!-- QUOTE -->
  <section>

    <div class="quote">

      <i class="fa-solid fa-quote-left"></i>

      <h2>
        Dreams transform into thoughts and thoughts result in action.
      </h2>

    </div>

  </section>

  <!-- BOOKS -->
  <section id="books">

    <div class="section-title">
      <h2>Books by Dr. Kalam</h2>
    </div>

    <div class="book-grid">

      <div class="book">

        <img
          src="https://images.unsplash.com/photo-1521587760476-6c12a4b040da?q=80&w=1200&auto=format&fit=crop">

        <div class="book-content">

          <h3>Wings of Fire</h3>

          <p>
            The inspiring autobiography of Dr. Kalam.
          </p>

        </div>

      </div>

      <div class="book">

        <img
          src="https://images.unsplash.com/photo-1512820790803-83ca734da794?q=80&w=1200&auto=format&fit=crop">

        <div class="book-content">

          <h3>Ignited Minds</h3>

          <p>
            A vision for empowering India’s youth.
          </p>

        </div>

      </div>

    </div>

  </section>

  <!-- STATS -->
  <section class="stats">

    <div class="stats-grid">

      <div class="stat">
        <h1>11th</h1>
        <p>President of India</p>
      </div>

      <div class="stat">
        <h1>1997</h1>
        <p>Bharat Ratna Award</p>
      </div>

      <div class="stat">
        <h1>50+</h1>
        <p>Universities Honored Him</p>
      </div>

      <div class="stat">
        <h1>Millions</h1>
        <p>Students Inspired</p>
      </div>

    </div>

  </section>

  <!-- FOOTER -->
  <footer>

    <h2>Dr. A.P.J. Abdul Kalam Memorial Website</h2>

    <p>
      Dedicated to education, innovation, and inspiration.
    </p>

    <br>

    <p>
      © 2026 Official Tribute Website
    </p>

  </footer>

</body>

</html>
